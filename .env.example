# ════════════════════════════════════════════════════
#  BZG Group Terminal — Environment Variables
#  Copy to .env.local and fill in your values.
#  NEVER commit .env.local to git.
# ════════════════════════════════════════════════════

# ── Supabase (from your project Settings > API) ──────
# Public URL — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key — safe to expose to browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER SIDE ONLY. NEVER prefix with NEXT_PUBLIC_.
# Used only in createAdminClient() for auth.admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────
# Full URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000