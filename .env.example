# ════════════════════════════════════════════════════
#  BZG Group Terminal — Environment Variables
#  Copy to .env.local (or .env — both are git-ignored) and fill in your values.
#  NEVER commit real values to git.
# ════════════════════════════════════════════════════

# ── Neon (Postgres) — new data layer ──────────────────
# Pooled connection (hostname contains "-pooler") — used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct connection (no "-pooler") — used by Prisma Migrate only
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# ── Auth.js ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-generated-secret-here
AUTH_TRUST_HOST=true

# ── Pusher (realtime) ─────────────────────────────────
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ── Cloudflare R2 (storage) ───────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=electrozaki-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ── Supabase — only for scripts/copy-supabase-to-neon.mjs until cut-over ─
# Session pooler URI (IPv4) from Supabase → Settings → Database
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# ── App ───────────────────────────────────────────────
# Full URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000