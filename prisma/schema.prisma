model warranty_events {
  event_id     String              @id @default(dbgenerated("('WEV-'::text || lpad((nextval('warranty_events_seq'::regclass))::text, 4, '0'::text))"))
  store_id     String              @default("EZ-001")
  txn_id       String
  facture_ref  String
  sav_doc_id   String?
  sav_ref      String?
  event_type   warranty_event_type
  event_date   DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes        String?
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  created_by   String?             @db.Uuid
  users        user_profiles?      @relation("warranty_events_created_byTouser_profiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ez_documents ez_documents?       @relation(fields: [sav_doc_id], references: [doc_id], onDelete: NoAction, onUpdate: NoAction)
  transactions transactions        @relation(fields: [txn_id], references: [txn_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([facture_ref], map: "idx_warranty_events_facture_ref")
  @@index([txn_id], map: "idx_warranty_events_txn_id")
}
